{
  "name": "lanclip",
  "productName": "Lanclip",
  "version": "0.1.0",
  "description": "Share clipboard, text, images and files across devices on your LAN",
  "main": "src/main.js",
  "license": "MIT",
  "author": { "name": "Lanclip", "email": "lanclip@users.noreply.github.com" },  "scripts": {
    "start": "electron .",
    "headless": "node src/headless.js",
    "test": "node test/smoke.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.lanclip",
    "productName": "Lanclip",
    "files": ["src/**", "ui/**", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true, "include": "build/installer.nsh" },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.utilities", "extendInfo": { "LSUIElement": true } },
    "linux": { "target": ["AppImage", "deb"], "category": "Utility" }
  }
}
